<?xml version="1.0" encoding="utf-8"?>
<!--
    The panel, laid out like the Mac's (sizes from ChromeMetrics, regular density):
    a control row (New Note, All Notes, close), a large centred title, the
    formatting pill, the note, and a footer with Settings and the Copy pill.
    Accent fills follow the Windows accent colour, as the Mac follows its own.
-->
<Window
    x:Class="Buoy.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="WindowRoot">
    <Grid.Resources>
        <!-- Text fields sit straight on the glass, with no box of their own. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

        <!-- A round accent button (Mac: buoyAccentCircle), 28 across. -->
        <Style x:Key="AccentCircleButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="IsTabStop" Value="False" />
        </Style>

        <!-- A segment of an accent pill: bare glyph, a light plate on hover and press.
             It never takes focus, so the editor keeps its selection while formatting. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="AllowFocusOnInteraction" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Plate" Background="Transparent" CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                Foreground="{TemplateBinding Foreground}" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Plate.Background" Value="#26FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Plate.Background" Value="#47FFFFFF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="Plate.Opacity" Value="0.5" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillDivider" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            <Setter Property="Opacity" Value="0.3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Grid.Resources>
    <Grid x:Name="Root" Padding="6,0,6,6">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Control row: traffic lights left (added in code), New Note and All Notes
             right, as on the Mac. The empty middle drags the window (see UpdateDragRegion). -->
        <Grid x:Name="Header" Height="34">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="DragArea" Grid.Column="1" Background="Transparent" />
            <StackPanel
                x:Name="HeaderButtons"
                Grid.Column="2"
                Margin="0,6,2,0"
                VerticalAlignment="Top"
                Orientation="Horizontal"
                Spacing="10">
                <Button
                    AutomationProperties.Name="All Notes"
                    Click="OnAllNotes"
                    Style="{StaticResource AccentCircleButton}"
                    ToolTipService.ToolTip="All Notes (Ctrl+L)">
                    <FontIcon FontSize="12" Glyph="&#xE700;" />
                </Button>
                <Button
                    AutomationProperties.Name="New Note"
                    Click="OnNewNote"
                    Style="{StaticResource AccentCircleButton}"
                    ToolTipService.ToolTip="New Note (Ctrl+N)">
                    <FontIcon FontSize="12" Glyph="&#xE710;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The title: large, centred, editable. Accent in light mode, white in dark. -->
        <TextBox
            x:Name="TitleBox"
            Grid.Row="1"
            MinHeight="26"
            Margin="12,6,12,4"
            Padding="0"
            AutomationProperties.Name="Note title"
            FontFamily="Segoe UI Variable Display"
            FontSize="19"
            FontWeight="SemiBold"
            KeyDown="OnTitleKeyDown"
            PlaceholderText="Untitled"
            TextAlignment="Center"
            TextChanged="OnTitleChanged">
            <TextBox.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Light">
                            <StaticResource x:Key="TextControlForeground" ResourceKey="AccentTextFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="AccentTextFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="AccentTextFillColorPrimaryBrush" />
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Dark">
                            <StaticResource x:Key="TextControlForeground" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlForegroundPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                            <StaticResource x:Key="TextControlForegroundFocused" ResourceKey="TextFillColorPrimaryBrush" />
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </TextBox.Resources>
        </TextBox>

        <!-- While this note's Harbor timer runs, the countdown stands in for the title;
             clicking it folds into Harbor Mode, where pause and stop live. -->
        <Button
            x:Name="TimerTitle"
            Grid.Row="1"
            Margin="12,6,12,4"
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="Timer"
            Background="Transparent"
            BorderThickness="0"
            Click="OnTimerTitle"
            ToolTipService.ToolTip="Show timer controls in Harbor Mode"
            Visibility="Collapsed">
            <TextBlock
                x:Name="TimerTitleText"
                HorizontalAlignment="Center"
                FontFamily="Segoe UI Variable Display"
                FontSize="19"
                FontWeight="SemiBold"
                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Button>

        <!-- The formatting pill (Mac: ToolbarView). -->
        <Border
            x:Name="Toolbar"
            Grid.Row="2"
            Margin="8,4,8,4"
            HorizontalAlignment="Center"
            AutomationProperties.Name="Formatting"
            Background="{ThemeResource AccentFillColorDefaultBrush}"
            CornerRadius="14">
            <StackPanel Orientation="Horizontal">
                <Button AutomationProperties.Name="Bold" Click="OnBold" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Bold (Ctrl+B)">
                    <TextBlock FontSize="13" FontWeight="Bold" Text="B" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button AutomationProperties.Name="Italic" Click="OnItalic" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Italic (Ctrl+I)">
                    <TextBlock FontSize="13" FontStyle="Italic" FontWeight="SemiBold" Text="I" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button AutomationProperties.Name="Underline" Click="OnUnderline" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Underline (Ctrl+U)">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="U" TextDecorations="Underline" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button AutomationProperties.Name="Strikethrough" Click="OnStrikethrough" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Strikethrough (Ctrl+Shift+X)">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="S" TextDecorations="Strikethrough" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button AutomationProperties.Name="Bullet List" Click="OnBullets" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Bullet List">
                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button AutomationProperties.Name="To-Do" Click="OnTodos" Style="{StaticResource PillButton}" ToolTipService.ToolTip="To-Do">
                    <FontIcon FontSize="14" Glyph="&#xE9D5;" />
                </Button>
                <Rectangle Style="{StaticResource PillDivider}" />
                <Button x:Name="LinkButton" AutomationProperties.Name="Insert Link" Click="OnLink" Style="{StaticResource PillButton}" ToolTipService.ToolTip="Insert Link (Ctrl+K)">
                    <FontIcon FontSize="12" Glyph="&#xE71B;" />
                </Button>
            </StackPanel>
        </Border>

        <InfoBar
            x:Name="Notice"
            Grid.Row="3"
            Margin="2,4,2,2"
            IsClosable="True"
            IsOpen="False" />

        <!-- The note. Clipped so a sliding note (previous/next) stays inside the glass;
             the snapshot is the outgoing note during that slide, and the effects layer
             holds the to-do pop. -->
        <Grid x:Name="EditorHost" Grid.Row="4" Margin="0,4,0,0">
            <RichEditBox x:Name="EditorBox" AutomationProperties.Name="Note" />
            <Image x:Name="SlideSnapshot" IsHitTestVisible="False" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />
            <Canvas x:Name="Effects" IsHitTestVisible="False" />
        </Grid>

        <!-- Footer (Mac: FooterView). -->
        <Grid x:Name="Footer" Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <HyperlinkButton
                x:Name="InfoButton"
                Margin="0,0,6,4"
                Padding="2,0"
                HorizontalAlignment="Right"
                Click="OnInfo"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                IsTabStop="False">
                <TextBlock x:Name="InfoText" FontSize="11" />
            </HyperlinkButton>

            <Button
                x:Name="SettingsButton"
                Grid.Row="1"
                Margin="2,0,0,0"
                HorizontalAlignment="Left"
                AutomationProperties.Name="Settings"
                Style="{StaticResource AccentCircleButton}"
                ToolTipService.ToolTip="Settings (Ctrl+,)">
                <FontIcon FontSize="12" Glyph="&#xE713;" />
                <Button.Flyout>
                    <Flyout x:Name="SettingsFlyout" Placement="TopEdgeAlignedLeft" ShouldConstrainToRootBounds="False" />
                </Button.Flyout>
            </Button>

            <Border
                Grid.Row="1"
                Margin="0,0,2,0"
                HorizontalAlignment="Right"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <Button AutomationProperties.Name="More actions" Style="{StaticResource PillButton}" ToolTipService.ToolTip="More actions">
                        <FontIcon FontSize="9" Glyph="&#xE70D;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="TopEdgeAlignedRight">
                                <MenuFlyoutItem Click="OnDeleteNote" Text="Delete Note">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Rectangle Height="16" Style="{StaticResource PillDivider}" />
                    <Button
                        Width="Auto"
                        AutomationProperties.Name="Copy note to clipboard"
                        Click="OnCopy"
                        Style="{StaticResource PillButton}"
                        ToolTipService.ToolTip="Copy note (Ctrl+Enter)">
                        <StackPanel Margin="10,0" Orientation="Horizontal" Spacing="4">
                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Copy" />
                            <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.8" Text="Ctrl+&#x21B5;" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Lower-centre toast (Mac: NotificationToast), above the footer. -->
        <Border
            x:Name="Toast"
            Grid.Row="4"
            Grid.RowSpan="2"
            Margin="0,0,0,40"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="14"
            IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="ToastIcon" FontSize="12" Glyph="&#xE73E;" />
                <TextBlock x:Name="ToastText" FontSize="12" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- Harbor Mode: the panel folded into a pill (Mac: MinimizedNotePillView).
         The title scrolls when it doesn't fit; with a timer, the countdown,
         pause and stop take its place. The empty part drags the window. -->
    <Grid
        x:Name="Pill"
        Padding="22,0,12,0"
        AutomationProperties.Name="Harbor Mode"
        ColumnSpacing="8"
        Visibility="Collapsed">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid x:Name="PillTitleLane" VerticalAlignment="Center" />
        <TextBlock
            x:Name="PillCountdown"
            VerticalAlignment="Center"
            FontFamily="Segoe UI Variable Display"
            FontSize="19"
            FontWeight="SemiBold"
            Visibility="Collapsed" />
        <Button
            x:Name="PillPause"
            Grid.Column="1"
            AutomationProperties.Name="Pause timer"
            Click="OnPillPause"
            Style="{StaticResource AccentCircleButton}"
            Visibility="Collapsed">
            <FontIcon x:Name="PillPauseGlyph" FontSize="11" Glyph="&#xE769;" />
        </Button>
        <Button
            x:Name="PillStop"
            Grid.Column="2"
            AutomationProperties.Name="Stop timer"
            Click="OnPillStop"
            Style="{StaticResource AccentCircleButton}"
            ToolTipService.ToolTip="Stop timer"
            Visibility="Collapsed">
            <Button.Resources>
                <SolidColorBrush x:Key="AccentButtonBackground" Color="#C42B1C" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#D13A2B" />
                <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#A82416" />
                <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="#E6FFFFFF" />
            </Button.Resources>
            <FontIcon FontSize="11" Glyph="&#xE71A;" />
        </Button>
        <Button
            x:Name="PillRestore"
            Grid.Column="3"
            AutomationProperties.Name="Restore note"
            Click="OnPillRestore"
            Style="{StaticResource AccentCircleButton}"
            ToolTipService.ToolTip="Restore (Ctrl+M)">
            <FontIcon FontSize="11" Glyph="&#xE70D;" />
        </Button>
    </Grid>
    </Grid>
</Window>